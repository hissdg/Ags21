#!/bin/sh
# ============================================================================
#  AGS21：让 LuCI 的静态资源 URL 在每次刷机后都不同（= 让浏览器重取前端资源）
#  装机位置：/etc/uci-defaults/99-ags21-luci-cachebust
#            （由 build/build-ags21.sh 第 3.52 步 install 进 target 覆盖层；
#              uci-defaults 的语义是首启执行一次后自删 —— 这里正好，只影响一次）
# ============================================================================
#
#  ── 不装它会怎样（2026-10-13 在设备上实测到）────────────────────────────
#  现象：首页「系统」面板里注入的「温度」整行不显示，「CPU 使用率（%）」正常。
#        而设备上的文件完全正确：10_system.js = 4537 字节、含注入段、
#        render() 的 fields 里 '温度' 与 ags21_temp 成对、索引 data[4]。
#        浏览器里 Ctrl+F5 硬刷新也没用。
#
#  根因：LuCI 给静态资源做的缓存清除，全靠 header.ut 里这一行
#          <script src="{{ resource }}/luci.js?v=<luci版本>-{{ pkgs_update_time }}">
#        （luci.js 会把 /luci-static/resources/ 下所有模块的 URL 都拼上同一个 ?v=）
#        而 pkgs_update_time 的取值是（见 /usr/share/ucode/luci/runtime.uc:182）：
#          stat('/lib/apk/db/installed')?.mtime ?? stat('/usr/lib/opkg/status')?.mtime ?? 0
#
#        本项目镜像里**所有文件**的 mtime 都被 SOURCE_DATE_EPOCH 钉成同一个
#        固定值（见构建产物 out/profiles.json 的 "source_date_epoch"，
#        实测 1782737960 = 上游发布构建时间），/lib/apk/db/installed 也不例外
#        ⇒ ?v= 每次构建一模一样 ⇒ 这个本该"逐构建变化"的缓存清除参数彻底失效。
#        后果：从上一版固件升级上来的浏览器一直命中缓存里那份**旧的**
#        10_system.js（没有注入段），首页自然少两行。
#        又因为加载模块是 JS 发起的 fetch（默认缓存模式），只要条目还在
#        "新鲜期"里就不会去校验，所以硬刷新也救不回来。
#
#        更糟的是那个固定不变的 Last-Modified 会把浏览器的**启发式新鲜度**
#        抬成 10% ×（刷机时刻 − 该固定值）。设备无 RTC，开机时时钟也停在这个
#        固定值上，实测比真实时间落后约 106 天 ⇒ 新鲜期约十天，等于十天不校验。
#
#  修法：首启把 /lib/apk/db/installed 的 mtime 改成一个**每次刷机都不同**的值，
#        ?v= 随之变化。浏览器手里全是没见过的 URL ⇒ 必然重新拉取 /luci-static/
#        下全部资源（luci.js / cbi.js / 各 status include 模块），问题消失。
#        注意**不能只写 `touch $f`** —— 原因见文件末尾那段说明。
#
#  ── 为什么放这里，而不是在构建脚本里改 SOURCE_DATE_EPOCH ────────────────
#  把 SOURCE_DATE_EPOCH 改成构建时刻同样能让 ?v= 变，但代价是：
#    ① 同源码两次构建产出不同 sha256 —— 放弃可复现构建；
#    ② 全部包的时间戳作废，很可能触发一次全量重编（1-3 小时）。
#  首启 touch 只影响每台设备上的一次缓存判定，代价接近零，且天然逐设备正确。
#
#  ── 以后万一还是看不到变化，手动等价操作 ────────────────────────────────
#      touch /lib/apk/db/installed
#  然后正常刷新页面即可（不需要硬刷新）。这是排查这类"改完前端看不见"的
#  第一手段 —— 先怀疑 ?v= 没变，再怀疑别的。
# ============================================================================

# ============================================================================
#  ── 为什么不能只写 `touch "$f"`（2026-10-13 首次实刷后发现的坑）──────────
#  本设备**无 RTC**：开机时时钟由 sysfixtime 从"镜像里最新的 mtime"取得，
#  而镜像里所有文件都冻结在 SOURCE_DATE_EPOCH ⇒ **每次开机时钟都从同一个值
#  附近起步**，uci-defaults 又在开机后固定几秒执行。
#  实测（刷机后 199 秒）：date = 1782738150，反推开机时刻 ≈ 1782737951，
#  就在冻结值 1782737960 附近 → 脚本执行时 touch 出的是 1782737961，
#  只与镜像原值差 **1 秒**。
#  ⇒ 裸 touch 得到的 mtime 每次刷机都落在「冻结值 ±10 秒」这个窄带里，
#    下一次刷机极可能拿到**与上一次完全相同**的值，`?v=` 不变
#    ⇒ 浏览器命中缓存 ⇒「改了前端看不见」原地复发。
#
#  所以这里改成：**在镜像原值之上加一个每次执行都不同的 24 位随机秒数**。
#   · 与历史任意一次刷机撞车的概率 < 1/1.6e7；
#   · 取值可能落到"未来"，这**无害且有利**：浏览器算启发式新鲜度
#     `0.1 × (Date − Last-Modified)` 会得到负值 ⇒ 判定为不新鲜 ⇒ 每次校验；
#     何况换了新 URL 本身就已经强制重新拉取一次。
#   · 原值从文件自身读（`date -r`），不依赖任何写死的常量。
#   · 设备已实测可用：`date -r <f> +%s` ✅、`touch -d @<epoch>` ✅、`$RANDOM` ✅
#     （`od` 不存在、`date -d "+30 days"` 不支持 —— 所以只用上面这三种。）
# ============================================================================

# apk 是 25.12+ 的默认包管理器；opkg 是兜底。谁在就动谁。
for f in /lib/apk/db/installed /usr/lib/opkg/status; do
	[ -f "$f" ] || continue

	base=$(date -r "$f" +%s 2>/dev/null) || base=''
	case "$base" in
		''|*[!0-9]*) base=$(date +%s) ;;	# 取不到就退回当前时钟
	esac

	# 24 位随机偏移：busybox ash 的 $RANDOM 是 0..32767，
	# 左移 15 位再异或一次凑出约 30 位，最后截到 2^24 以内。
	off=$(( ((RANDOM << 15) ^ RANDOM) % 16777216 + 1 ))

	# 兜底：万一 busybox 的 touch 不认 -d @epoch，退回普通 touch（至少还有个值）
	touch -d "@$((base + off))" "$f" 2>/dev/null || touch "$f"
done

exit 0
